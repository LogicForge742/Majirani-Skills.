# Environment variables for the Majirani Skills backend
# Copy this file to .env and fill in your values

DATABASE_URL="postgresql://majirani:majirani_secret@localhost:5432/majirani_db?schema=public"

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

PORT=3000

FRONTEND_URL="http://localhost:8080"

# ─── Cloudinary (File Storage) ────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier: 25GB storage / 25GB bandwidth
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
